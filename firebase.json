{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "README.md",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "content/goal-*.json",
      "content/*.md",
      "content/*.py",
      "content/validate.py"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/go-goals-game.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}